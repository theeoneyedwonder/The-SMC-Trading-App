{
  "name": "quant-core",
  "version": "0.2.0",
  "description": "QUANT_CORE - Smart Money Concepts Trading Dashboard",
  "private": true,
  "type": "module",
  "author": "theeoneyedwonder",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dev:all": "concurrently -k --names VITE,ELECTRON --prefix-colors cyan,yellow \"vite\" \"wait-on http://localhost:5175 && electron .\"",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.theeoneyedwonder.quantcore",
    "productName": "QUANT_CORE",
    "copyright": "Copyright (c) 2026 theeoneyedwonder",
    "icon": "build/icon.png",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/quant-core-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QUANT_CORE",
      "uninstallDisplayName": "QUANT_CORE",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "theeoneyedwonder",
      "repo": "QUANT_CORE"
    }
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.40.0",
    "lightweight-charts": "^5.2.0",
    "material-symbols": "^0.45.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
    "wait-on": "^8.0.1"
  }
}
